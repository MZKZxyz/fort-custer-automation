[Unit]
Description=Fort Custer independent container deadline watchdog
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=fc-watchdog
Group=docker
ExecStart=/usr/bin/python3 /opt/fort-custer-automation/src/host_watchdog.py
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
